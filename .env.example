# --- 必須 ---
# ツール全体の入口パスワード
APP_PASSWORD=

# Neon Postgres（Vercel Storage連携で自動設定される）
DATABASE_URL=

# AI提案（プロバイダは AI_PROVIDER で切替。未指定なら設定済みキーから自動選択）
# 無料枠あり: gemini / groq / openrouter
AI_PROVIDER=            # anthropic | gemini | groq | openrouter | openai
AI_MODEL=               # 任意: モデル名を上書き（例: gemini-flash-latest）
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=        # openai互換の独自エンドポイントを使う場合のみ

# --- 任意 ---
# 管理者用マスターパスワード（設定すると誰のペイン2〜4も開ける）
MASTER_PASSWORD=

# Notion同期（4つとも設定したときだけ有効）
NOTION_API_KEY=
NOTION_MEMBERS_DB_ID=
NOTION_GOALS_DB_ID=
NOTION_LOGS_DB_ID=
NOTION_SUGGESTIONS_DB_ID=

# Notion DB自動作成スクリプト用（親ページのID。ページURL末尾の32文字）
NOTION_PARENT_PAGE_ID=

# メールリマインド / 週次レポート
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
CRON_SECRET=
