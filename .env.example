# --- 必須 ---
# ツール全体の入口パスワード
APP_PASSWORD=

# Neon Postgres（Vercel Storage連携で自動設定される）
DATABASE_URL=

# AI提案（Claude API）
ANTHROPIC_API_KEY=

# --- 任意 ---
# 管理者用マスターパスワード（設定すると誰のペイン2〜4も開ける）
MASTER_PASSWORD=

# Notion同期（4つとも設定したときだけ有効）
NOTION_API_KEY=
NOTION_MEMBERS_DB_ID=
NOTION_GOALS_DB_ID=
NOTION_LOGS_DB_ID=
NOTION_SUGGESTIONS_DB_ID=

# Notion DB自動作成スクリプト用（親ページのID。ページURL末尾の32文字）
NOTION_PARENT_PAGE_ID=

# メールリマインド / 週次レポート
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
CRON_SECRET=
